# ============================================================
# ORBITAL SHIELD — Integration-Final Environment Configuration
# ============================================================
# Copy this file to .env in the repo root and edit as needed.
#
# Two runtime modes:
#   single-machine demo : leave everything at 127.0.0.1
#   two-machine demo    : set SAT_HOST to the LAN IP of the satellite machine
#                         and GS_HOST to the ground-station machine's LAN IP.

# ---- identity of THIS machine's role ----
GS_HOST=127.0.0.1
SAT_HOST=127.0.0.1

# ---- service ports (must match the port table in integration prompt) ----
SIMULATOR_PORT=8000
DOWNLINK_PORT=8001
ACCESS_PORT=8002
FIRMWARE_PORT=8003
UPLINK_PORT=8004
MLBRAIN_PORT=8005
AUDIT_PORT=8006
DASHBOARD_PORT=5173

# ---- fully resolved URLs, built from the above, used by every module ----
# In two-machine mode: change only SAT_HOST and GS_HOST above;
# all modules read these variables so NO internal code changes are needed.
SIMULATOR_URL=http://${SAT_HOST}:${SIMULATOR_PORT}
DOWNLINK_URL=http://${GS_HOST}:${DOWNLINK_PORT}
ACCESS_URL=http://${GS_HOST}:${ACCESS_PORT}
FIRMWARE_URL=http://${GS_HOST}:${FIRMWARE_PORT}
UPLINK_URL=http://${GS_HOST}:${UPLINK_PORT}
MLBRAIN_URL=http://${GS_HOST}:${MLBRAIN_PORT}/events/ingest
AUDIT_URL=http://${GS_HOST}:${AUDIT_PORT}/audit/events

# ---- module-specific aliases (kept for backward compat with standalone scripts) ----
ML_BRAIN_URL=${MLBRAIN_URL}
AUDIT_SERVICE_URL=${AUDIT_URL}
PERSON_1_SIMULATOR_URL=${SIMULATOR_URL}/commands/execute
PERSON_5_ML_CORRELATION_URL=${MLBRAIN_URL}
PERSON_6_AUDIT_URL=${AUDIT_URL}

# ---- dashboard Vite env vars (prefix VITE_ required by Vite) ----
VITE_AUDIT_URL=http://${GS_HOST}:${AUDIT_PORT}
VITE_MLBRAIN_URL=http://${GS_HOST}:${MLBRAIN_PORT}
