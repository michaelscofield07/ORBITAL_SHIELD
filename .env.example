# Database Configuration
DATABASE_URL=sqlite:///./downlink.db

# Machine Learning Model Configuration
MODEL_PATH=models/isolation_forest.joblib
BASELINE_DATA_PATH=data/baseline/sample_normal_telemetry.csv

# Satellite Configuration
SATELLITE_ID=SAT-EO-01

# Integrity Verification Tolerances
TIMESTAMP_TOLERANCE_SECONDS=30.0
TIMESTAMP_MAX_AGE_SECONDS=86400.0

# Anomaly Scoring & Severity Thresholds
# IsolationForest: negative scores are outliers (more negative = more anomalous)
ANOMALY_THRESHOLD=0.0
HIGH_SEVERITY_THRESHOLD=-0.15
CRITICAL_SEVERITY_THRESHOLD=-0.30

# Feature Extraction Window
SEQUENCE_WINDOW_SIZE=100

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
